    type="continuous">
    <origin
      xyz="-0.0353553390593261 0.0353553390593286 -0.00364999999999994"
      rpy="0 0 0" />
    <parent
      link="front_right_leg_upper_link" />
    <child
      link="front_right_leg_lower_link" />
    <axis
      xyz="0 0 -1" />
  </joint>

  <!-- ═══════════════ Feet (fixed, for RViz / TF) ═══════════════ -->
  <xacro:macro name="foot" params="prefix">
    <link name="${prefix}_foot_link">
      <visual>
        <geometry><sphere radius="${foot_r}"/></geometry>
        <material name="mp4_foot"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${foot_r}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_leg_lower_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="${foot_xy} ${foot_xy} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:foot prefix="front_right"/>
  <xacro:foot prefix="front_left"/>
  <xacro:foot prefix="back_right"/>
  <xacro:foot prefix="back_left"/>

  <!-- ═══════════════ Ground frame ═══════════════
       base_link stays the TF root (the EKF publishes odom -> base_link, as in
       ros2jazzymp4); base_footprint hangs below it on the ground plane for
       tools that want one. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-stand_height}" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════ Mounting: MEASURE THESE ON THE ROBOT ═══════════════ -->

  <!-- BMI270 on the MP4 ESP32 CORE. The bridge already rotates the chip axes
       into REP-103 body axes (imu_axis_map / imu_axis_sign in
       esp_bridge.yaml), so this frame is aligned with base_link; only the
       position is a placeholder. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LD06 lidar (driver: mini_pupper_driver/lidar_ld06.launch.py, frame
       lidar_link), in the Mini Pupper 2 position: on the rear of the back
       plate, 12.7 mm behind the rear hip axis and 68.5 mm above the hip
       plane, rotated +90 deg about z (the LD06's zero angle points to the
       robot's left in that holder). Taken from mini_pupper_2's URDF
       (base_board + pcb_lidar) and re-based on this model's rear hips.
       CHECK: with the robot standing, put a box ~30 cm in FRONT of it - in
       RViz the /scan points must appear in front (+x, red axis). If they
       appear behind or to the side, fix the yaw here (+/-1.5708 or 3.1416). -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 -0.0105" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.021"/></geometry>
      <material name="mp4_lidar"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.0612 0.0005 0.0685" rpy="0 0 1.5708"/>
  </joint>

  <!-- Optional camera (sensors.camera in mini_pupper_mp4.yaml). -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.07 0 0.02" rpy="0 0 0"/>
  </joint>

</robot>
