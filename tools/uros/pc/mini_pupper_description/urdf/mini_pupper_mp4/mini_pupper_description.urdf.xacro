<?xml version="1.0"?>
<!--
  Mini Pupper on the MP4 ESP32 CORE board (mpv2 firmware, ESP does the kinematics).

  The links, joints and meshes below are the SolidWorks export used by the
  minipupperesp MuJoCo sim (sim/model/urdf/sku_1_urdf_fixed.urdf), with two
  fixes: mesh paths point into this package, and the exporter's
  "back_riht_leg_upper_joint" typo is corrected.

  Joint angles come from mini_pupper_esp_bridge, which turns the firmware's
  servo angles into these joints with config/servo_map.yaml - the same maths
  as minipupperesp/sim/pupper_map.py, proven there against the firmware IK.
  At the stand pose (all servos at 0) the thighs are at +/-0.1304 rad and
  the knees at +/-0.1318 rad, and base_link is 75.0 mm above the ground.

  Things measured on the real robot belong in the "mounting" block at the
  bottom (IMU, lidar, camera). They are placeholders until then.
-->
<robot name="mini_pupper_mp4" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Accepted for launch-file compatibility with the other models; unused. -->
  <xacro:arg name="use_gazebo_hardware" default="false"/>
  <xacro:arg name="use_debug_stand" default="false"/>

  <!-- base_link height above flat ground at the neutral stand (from the sim keyframe). -->
  <xacro:property name="stand_height" value="0.07503"/>
  <!-- Foot ball: centre in each lower-leg frame, radius (fitted to the mesh). -->
  <xacro:property name="foot_xy" value="0.0390676"/>
  <xacro:property name="foot_r" value="0.0049"/>

  <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.00496398423144198 -5.0621595029991E-05 -0.00206625375179828"
        rpy="0 0 0" />
