# Santy Control: ESP32-S3-WROOM-1-N16R8.

# 16 MB flash. CONFIG_ESPTOOLPY_FLASHSIZE picks partitions_16MB.csv, which is
# the table with the 2904K `model` partition esp-sr needs.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB octal PSRAM, same part as the MP4 board. Required, not optional: see
# docs/voice.md and the note in AGENTS.md about XIP_FROM_PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Allocations at or below this go to internal RAM; everything larger goes to
# PSRAM. 512 is the MP4 board's value and the IDF default.
#
# 256 here because internal RAM is the binding constraint on this board once
# the display, Wi-Fi, the web server, Opus and a WebSocket are all up -- the
# symptom is the LVGL bounce buffer failing to allocate and the panel filling
# the log with ESP_ERR_NO_MEM. Halving the threshold moves a large number of
# small allocations off internal RAM at no cost anyone can hear.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n

# Console on UART0 via the CH340K.
#
# NOT USB-Serial-JTAG: IO19 and IO20 are the native USB pins and this board
# wires them to the DRV8833 motor driver, so that peripheral is unusable here.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The agent, the web UI, cap_display and the `selftest` command.
CONFIG_MP4_ROBOT_ENABLE=y

# No servo harness on this board -- see board_devices.yaml. Without this,
# driver_board_init() would claim SPI3 and four chip-select GPIOs that belong
# to the camera connector.
CONFIG_MP4_ROBOT_SERVO_ENABLE=y

# Phase 4 of docs/voice-plan.md (components/mpx_voice_wake): AEC + VAD +
# WakeNet for barge-in. Only the wake and VAD models are selected below --
# MultiNet (on-device fixed-phrase command matching) is left out on purpose.
# This board's voice architecture is Option A, cloud-as-brain (see
# docs/voice-plan.md's "What stays and what goes"): nothing here does
# on-device command recognition, the cloud's ASR does all transcription, so
# MultiNet would be ~2.1 MB of the 2904K model partition spent on a
# capability nothing calls.
CONFIG_MP4_VOICE_ENABLE=y

# ---- esp-sr models (see CONFIG_MP4_VOICE_ENABLE above) -----------------
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_HIESP=y            # wake word: "Hi ESP", ~296K
CONFIG_SR_VADN_VADNET1_MEDIUM=y     # neural VAD (AFE's vad_init), ~292K
CONFIG_SR_NSN_WEBRTC=y              # classic NS, no flash model of its own
CONFIG_SR_MN_EN_NONE=y              # no on-device command matching -- see above
CONFIG_SR_MN_CN_NONE=y

# ---- Audio codecs ----------------------------------------------------
#
# CODEC_DUMMY_SUPPORT is what backs `chip: internal` on audio_dac. The
# MAX98357A has no control interface -- there is nothing to drive but I2S --
# so the board manager needs the "dummy" codec compiled in to represent it.
#
# Without this the device simply is not created: the board still boots, the
# ES7210 still records, and audio_dac is absent with no error anywhere. The
# only symptom is `audio info` reporting "speaker : absent", which reads like
# a hardware fault rather than a missing Kconfig symbol.
CONFIG_CODEC_DUMMY_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y

# esp_codec_dev takes an i2c_master_bus_handle_t rather than the legacy port.
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Display is present.
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y

# Camera connector is unpopulated for voice work.
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=n
