# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory
.vscode/
.cursor/

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows
dependencies.lock

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory

# sdkconfig is per-machine output of `idf.py menuconfig`, not a source file.
# It used to be committed, so the identity source (and every other setting) was
# inherited from whoever built last, and CI had no idea which chip to build for.
# sdkconfig.defaults* carry the committed configuration instead.
sdkconfig
sdkconfig.old
sdkconfig.before_*

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
# General workspace files, can be from various tools
*.workspace 
# Visual Studio Solution User Options
*.suo       
# Visual Studio
*.sln.docstates 

# misc
*.pem
# ... except the one certificate that has to ship inside the firmware: the
# key-encryption public key the robot seals its derived key to
# (ROBOT_IDENTITY_AND_KEYS.md §6.4). It is public by definition and useless
# without the KMS private key, so it belongs in the tree.
!components/mpx_identity/certs/*.pem

# pi agent task artifacts/
# Bench station output. The registration JSON holds K_v in the clear, so it must
# never be committed -- the cloud import is a one-shot and the file is deleted
# afterwards. `bench/` also collects flash logs and espefuse dumps.
/bench/
# Station private keys (the KMS seal key's dev stand-in).
tools/secrets/
.pi/

# PWA Dependency folders
node_modules/
www/

# The eFuse custom table is generated from main/esp_efuse_custom_table.csv by the
# efuse component during the build. The CSV is the source; these two are output.
main/esp_efuse_custom_table.c
main/include/esp_efuse_custom_table.h
