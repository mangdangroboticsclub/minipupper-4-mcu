# Project sdkconfig defaults.
# Seeded so a fresh `idf.py reconfigure` / `fullclean` keeps these values.

# The HTTP server (network/http_server.cc) sets max_open_sockets = 12, which
# needs LWIP_MAX_SOCKETS >= 12 + 3 (internal) = 15. Default 10 caused
# "max_open_sockets is too large (max allowed 7)" and the server failed to
# start. 16 leaves a little headroom for the websocket chat + PWA serving.
CONFIG_LWIP_MAX_SOCKETS=16

# Socket recycling.  With frequent PWA polling (wifi/status, robot/status,
# marketplace), the default TIME_WAIT of 2*MSL = 2*60 s = 120 s made closed
# sockets linger for two minutes and exhaust the 16-socket pool ("Failed to
# create socket", accept errno 23).  Shorten MSL to 10 s (TIME_WAIT ~20 s) and
# enable SO_LINGER so the marketplace proxy can force an immediate close.
CONFIG_LWIP_TCP_MSL=10000
CONFIG_LWIP_SO_LINGER=y

# External PSRAM. Board is ESP32-S3-WROOM-1-N16R8 = 8 MB OCTAL PSRAM (see
# partitions.csv). It was disabled, so the WASM sandbox's 128 KB linear
# memory fell back to internal DRAM and every skill failed with
# "Failed to instantiate". Enabling octal PSRAM gives it 8 MB to work in.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# local-claw: the mpv2 movement players (robot/moves_mpe.inc) pace their 5 ms
# frames with vTaskDelay(1) against esp_timer. At the IDF default of 100 Hz a
# tick is 10 ms, so every table move would play at half speed and the jumps
# would not leave the ground. mpv2 / mpv2-claw run at 1000 Hz; so does this.
CONFIG_FREERTOS_HZ=1000

# local-claw: 6 MB app + a 1 MB esp-sr model partition (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# local-claw: LVGL for the ST7789 face (main/display). Same choices as
# mpv2-claw's build: RGB565, the C library allocator (so a 150 KB GIF frame
# buffer lands in PSRAM through the normal malloc policy instead of LVGL's
# fixed pool), the stdio file driver on drive letter 'S' (83) so the GIF
# decoder streams "S:/fs/display/x.gif", and LVGL's bundled GIF decoder,
# which cap_display_face.c drives directly. Widgets the face does not use
# are left at LVGL's defaults; they cost flash only when referenced.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH=""
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096
CONFIG_LV_USE_GIF=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_LINE=y
CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
