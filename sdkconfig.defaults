# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8MB.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_VOLUME_COUNT=3
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_HEAP_TASK_TRACKING=n
CONFIG_LWIP_LOCAL_HOSTNAME="esp-claw"
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_MMAP_FILE_NAME_LENGTH=32
CONFIG_CLAW_CORE_STAGE_VERBOSITY_VERBOSE=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_VFS_MAX_COUNT=12
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_FILE_SUPPORT=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=128
CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=256
# Display page: GIF animations streamed from the storage partition
# ("S:/fatfs/display/x.gif" -> stdio). GIF decodes to an RGB565 buffer in PSRAM.
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_USE_GIF=y
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH=""
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# The LCD panel's own SPI DMA transmit buffer is internal-RAM-only by
# hardware necessity, and there is nothing in this project that can move
# it -- it belongs to the ESP-Claw LCD driver. What IS movable is
# everything competing with it for that same internal, DMA-capable heap.
# The LVGL render thread's own task stack is one of those competitors and
# has no DMA requirement of its own (it is plain CPU-touched code, not a
# hardware transmit buffer), so it is safe to push to PSRAM -- freeing
# real internal headroom for the buffer that actually needs to be there.
# Found this while chasing "spi_master: Failed to allocate priv TX
# buffer" / "Draw bitmap failed: ESP_ERR_NO_MEM" flooding the log any time
# a websocket (voice or OTA) stays open for a while: `voice connect`
# logged the internal heap's largest free block at only 9216 bytes even
# BEFORE the socket opened, which is too tight a margin for this firmware's
# full feature set (Wi-Fi + LVGL + I2S + TLS) to share reliably.
CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM=y

#
# BLE: OFF.
#
# Nothing in this firmware uses the radio for Bluetooth. The only BLE
# consumers anywhere in ESP-Claw are lua_module_ble and lua_module_ble_hid,
# and both are off (CONFIG_APP_CLAW_LUA_MODULE_BLE / _BLE_HID are not set).
# With CONFIG_BT_ENABLED=y the controller and NimBLE host are still linked,
# and the controller reserves its static working memory in internal .bss at
# boot whether or not anything ever calls esp_bt_controller_init() -- that
# is tens of KB of the one memory this firmware is short of (see the
# ALWAYSINTERNAL notes in boards/*/sdkconfig.defaults.board), plus the
# Wi-Fi/BT coexistence code it drags into IRAM. Found while bringing the
# esp-sr audio front end up on mp4_esp32_core: the LCD's SPI DMA bounce
# buffer could no longer be allocated once the AFE was created.
#
# To turn BLE back on for a Lua BLE skill, set CONFIG_BT_ENABLED=y and
# restore the NimBLE sizing below (kept here, commented, so it is not lost):
CONFIG_BT_ENABLED=n
# CONFIG_BT_ENABLED=y
# CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
# CONFIG_BTDM_CTRL_MODE_BTDM=n
# CONFIG_BT_BLUEDROID_ENABLED=n
# CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# CONFIG_BT_NIMBLE_MAX_BONDS=2
# CONFIG_BT_NIMBLE_MAX_CCCDS=2
# CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
# CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
# CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
# CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
# CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
# CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64
# CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=15
# CONFIG_BT_NIMBLE_GATT_CLIENT=n
# CONFIG_BT_NIMBLE_DYNAMIC_SERVICE=y
# CONFIG_BT_NIMBLE_NVS_PERSIST=y
# CONFIG_BT_ALARM_MAX_NUM=20
# CONFIG_BT_NIMBLE_PRINT_ERR_NAME=n
# CONFIG_BT_CTRL_BLE_MAX_ACT=2
# CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=1
# CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
# CONFIG_BT_CTRL_BLE_SCAN_DUPL=n

# Wi-Fi static TX buffers: 8, not the default 16.
#
# With CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y the driver cannot use dynamic
# TX buffers (Kconfig forbids the combination), so every static buffer is
# ~1.6 KB of internal DMA memory allocated at esp_wifi_init() and never
# returned: 16 of them is ~26 KB. The 32 cache TX buffers (in PSRAM) absorb
# bursts from the TCP/IP stack before a static buffer is even needed, and
# this firmware's traffic is an Opus voice stream plus a couple of PWA
# websockets, not a bulk transfer, so 8 leaves headroom. Same reasoning as
# the RX buffer counts above.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# See https://github.com/espressif/esp-claw/issues/101
CONFIG_HTTP_REUSE_ENABLE=n

