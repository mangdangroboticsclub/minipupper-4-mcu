CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n

# Audio Encoder Configuration
CONFIG_AUDIO_ENCODER_AAC_SUPPORT=y
CONFIG_AUDIO_ENCODER_G711_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_ENCODER_OPUS_SUPPORT=n
CONFIG_AUDIO_ENCODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_ALAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_PCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_SBC_SUPPORT=n
CONFIG_AUDIO_ENCODER_LC3_SUPPORT=n
CONFIG_AUDIO_ENCODER_G722_SUPPORT=n
# For IDF 6: Support Cross-signed SSL Certificate
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Vision/Image: Pixel Convert Support
CONFIG_PIX_CVT_RGB565_TO_RGB565_SUPPORT=n
CONFIG_PIX_CVT_RGB565_TO_RGB888_SUPPORT=n
CONFIG_PIX_CVT_RGB565_TO_GRAY_SUPPORT=y
CONFIG_PIX_CVT_RGB565_TO_HSV_SUPPORT=y
CONFIG_PIX_CVT_RGB888_TO_RGB888_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_RGB565_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_RGB888_TO_HSV_SUPPORT=y
CONFIG_PIX_CVT_GRAY_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_HSV_TO_HSV_MASK_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_RGB888_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_RGB565_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_GRAY_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_HSV_SUPPORT=n
CONFIG_PIX_CVT_YUV_TO_YUV_SUPPORT=n

# IDF's system event task runs every Wi-Fi and IP handler, including
# wifi_manager's. The default 2304 bytes is sized for IDF's own handlers; this
# firmware chains a log-capture vprintf hook onto every ESP_LOGx, which costs
# a few hundred bytes on whichever task logs. Headroom, not a fix -- the fix
# is that main.c does its network-status work on its own task (see
# main_net_status_task), so nothing heavy runs here.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- Internal RAM: code that does not need to be in IRAM ------------------
#
# On the ESP32-S3, IRAM and DRAM are carved out of the same 512 KB of SRAM,
# so every KB of code that lives in IRAM is a KB the heap does not get. A
# -Og debug build of this firmware loads ~134 KB into IRAM. These are the
# standard IDF "reduce IRAM usage" knobs: they move code that is never run
# with the flash cache disabled out to flash (which, with
# CONFIG_SPIRAM_XIP_FROM_PSRAM above, actually executes from PSRAM).
#
# -Os rather than -Og: a smaller IRAM footprint, a smaller app image (the
# debug build had 4% of its 5 MB OTA slot left), and faster code -- -Og
# is the least optimised of the three and esp-sr's AEC/WakeNet inference
# is CPU-bound. Backtraces still resolve; only single-stepping gets worse.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# Not CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH: it is only ~4 KB, and it is
# unsafe if anything calls the heap from an IRAM ISR while the cache is off
# (an OTA or NVS write), which is not something worth auditing for 4 KB.

# Music (components/cap_music): the simple player hands out 16 kHz mono
# 16-bit -- the voice rate, because the speaker and the always-listening
# microphone share one I2S clock on this board.
CONFIG_AUDIO_SIMPLE_PLAYER_RESAMPLE_DEST_RATE=16000
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_CH_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_CH_CVT_DEST=1
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_BIT_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_BIT_CVT_DEST_16BIT=y

# mpv2-uros: no Raspberry Pi; the robot is a ROS 2 node itself (components/mpx_uros).
# CONFIG_MP4_PI_LINK_ENABLE is not set
